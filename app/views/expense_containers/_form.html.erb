<%# locals: (container:) %>

<%# Reuses the colour/icon picker the category form uses, so containers get real
    swatches and a lucide icon grid instead of a dropdown of hex strings. %>
<div data-controller="color-icon-picker" data-color-icon-picker-preset-colors-value="<%= ExpenseContainer::COLORS %>">
  <%= styled_form_with model: container, class: "space-y-4" do |f| %>
    <section class="space-y-4">
      <div class="w-fit mx-auto relative">
        <span data-color-icon-picker-target="avatar"
              class="w-14 h-14 flex items-center justify-center rounded-full"
              style="background-color: color-mix(in oklab, <%= container.display_color %> 10%, transparent); color: <%= container.display_color %>">
          <%= icon(container.display_icon, size: "2xl", color: "current") %>
        </span>

        <%= render DS::Disclosure.new(
              summary_class: "cursor-pointer absolute -bottom-2 -right-2 flex justify-center items-center bg-surface-inset hover:bg-surface-inset-hover border-2 w-7 h-7 border-subdued rounded-full text-secondary",
              data: {
                color_icon_picker_target: "details",
                action: "mousedown->color-icon-picker#handleOutsideClick"
              }
            ) do |disclosure| %>
          <% disclosure.with_summary_content do %>
            <%= icon("pen", size: "sm") %>
          <% end %>

          <div class="fixed right-0 sm:right-auto mx-2 sm:ml-8 sm:mr-0 mt-2 z-50 bg-container p-4 border border-alpha-black-25 rounded-2xl shadow-xs h-fit" data-color-icon-picker-target="popup">
            <div class="flex gap-2 flex-col mb-4" data-color-icon-picker-target="selection">
              <div data-color-icon-picker-target="pickerSection"></div>
              <h4 class="text-secondary text-sm"><%= t(".color") %></h4>
              <div class="flex flex-wrap md:flex-nowrap gap-2 items-center" data-color-icon-picker-target="colorsSection">
                <% ExpenseContainer::COLORS.each do |color| %>
                  <label class="relative">
                    <%= f.radio_button :color, color, class: "sr-only peer", data: { action: "change->color-icon-picker#handleColorChange" } %>
                    <div class="w-6 h-6 rounded-full cursor-pointer peer-checked:ring-2 peer-checked:ring-offset-2 peer-checked:ring-gray-500" style="background-color: <%= color %>"></div>
                  </label>
                <% end %>
              </div>
            </div>

            <div class="flex flex-wrap gap-2 justify-center flex-col w-auto md:w-87">
              <h4 class="text-secondary text-sm"><%= t(".icon") %></h4>
              <div class="flex flex-wrap gap-0.5 max-h-52 overflow-auto">
                <% ExpenseContainer.icon_codes.each do |icon_code| %>
                  <label class="relative">
                    <%= f.radio_button :lucide_icon, icon_code, class: "sr-only peer", data: { action: "change->color-icon-picker#handleIconChange change->color-icon-picker#handleIconColorChange", color_icon_picker_target: "icon" } %>
                    <div class="text-secondary w-7 h-7 flex m-0.5 items-center justify-center rounded-full cursor-pointer hover:bg-container-inset-hover peer-checked:bg-container-inset border border-transparent">
                      <%= icon(icon_code, size: "sm", color: "current") %>
                    </div>
                  </label>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <% if container.errors.any? %>
        <%= render "shared/form_errors", model: container %>
      <% end %>

      <div class="space-y-2">
        <%= f.text_field :name, label: t(".name"), placeholder: t(".name_placeholder"), required: true, autofocus: true %>
        <%= f.text_area :description, label: t(".description"), placeholder: t(".description_placeholder"), rows: 3 %>
        <%= f.number_field :target_amount, label: t(".target_amount"), step: "0.01", min: "0", placeholder: "0.00" %>
        <p class="text-xs text-secondary"><%= t(".target_amount_help") %></p>

        <div class="grid grid-cols-2 gap-3">
          <%= f.date_field :starts_on, label: t(".starts_on") %>
          <%= f.date_field :ends_on, label: t(".ends_on") %>
        </div>
      </div>
    </section>

    <%= f.submit t(".submit") %>
  <% end %>
</div>
