<div class="space-y-4">
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0">
      <div class="flex items-center gap-2">
        <span class="w-9 h-9 flex items-center justify-center rounded-full shrink-0"
              style="background-color: color-mix(in oklab, <%= @container.display_color %> 12%, transparent); color: <%= @container.display_color %>">
          <%= icon(@container.display_icon, size: "sm", color: "current") %>
        </span>
        <h1 class="text-xl font-medium text-primary truncate"><%= @container.name %></h1>
      </div>
      <% if @container.description.present? %>
        <p class="text-sm text-secondary mt-1"><%= @container.description %></p>
      <% end %>
    </div>
    <div class="flex items-center gap-2 shrink-0">
      <%= link_to t(".edit"), edit_expense_container_path(@container),
                  class: "btn btn--outline", data: { turbo_frame: "modal" } %>
      <% if @container.active? %>
        <%= button_to t(".archive"), archive_expense_container_path(@container),
                      method: :patch, class: "btn btn--outline" %>
      <% else %>
        <%= button_to t(".activate"), activate_expense_container_path(@container),
                      method: :patch, class: "btn btn--outline" %>
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
    <div class="bg-container rounded-xl p-4">
      <p class="text-xs uppercase tracking-wide text-secondary"><%= t(".spent") %></p>
      <p class="text-lg font-medium text-primary"><%= Money.new(@container.total_spent, @container.currency).format %></p>
    </div>
    <div class="bg-container rounded-xl p-4">
      <p class="text-xs uppercase tracking-wide text-secondary"><%= t(".target") %></p>
      <p class="text-lg font-medium text-primary">
        <%= @container.target_amount.present? ? Money.new(@container.target_amount, @container.currency).format : t(".no_target") %>
      </p>
    </div>
    <div class="bg-container rounded-xl p-4">
      <p class="text-xs uppercase tracking-wide text-secondary"><%= t(".remaining") %></p>
      <p class="text-lg font-medium <%= @container.over_budget? ? "text-destructive" : "text-primary" %>">
        <% if @container.remaining.present? %>
          <%= Money.new(@container.remaining, @container.currency).format %>
        <% else %>
          &mdash;
        <% end %>
      </p>
      <% if @container.over_budget? %>
        <p class="text-xs text-destructive"><%= t(".over_budget") %></p>
      <% end %>
    </div>
  </div>

  <div class="space-y-2">
    <p class="text-xs uppercase tracking-wide text-secondary"><%= t(".transactions_title") %></p>
    <% if @entries.empty? %>
      <div class="text-center py-12 space-y-1">
        <p class="text-sm font-medium text-primary"><%= t(".empty") %></p>
        <p class="text-sm text-secondary"><%= t(".empty_description") %></p>
      </div>
    <% else %>
      <div class="bg-container rounded-xl divide-y divide-alpha-black-100">
        <% @entries.each do |entry| %>
          <%= render "entries/entry", entry: entry %>
        <% end %>
      </div>
      <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
    <% end %>
  </div>
</div>
