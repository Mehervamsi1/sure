<% content_for :title, t(".title") %>

<div class="flex justify-center p-4 sm:p-6 lg:p-8">
  <div class="w-full max-w-2xl">
    <div class="bg-container border border-primary rounded-xl p-6 sm:p-8 space-y-4">
      <h1 class="text-xl sm:text-2xl font-bold text-primary"><%= t(".heading") %></h1>
      <% if @document %>
        <p class="text-xs text-secondary">
          <%= t(".version", version: @document.version, date: l(@document.effective_at.to_date, format: :long)) %>
        </p>
        <div class="prose prose-sm max-w-none text-primary"><%= simple_format(@document.body) %></div>
      <% else %>
        <p class="text-sm sm:text-base text-subdued"><%= t(".placeholder") %></p>
      <% end %>
    </div>
  </div>
</div>
